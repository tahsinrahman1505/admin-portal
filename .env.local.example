# ── Admin Portal environment ─────────────────────────────────────────────────
# Copy to .env.local (git-ignored) and fill in real values, or set these in
# Vercel → Settings → Environment Variables for the deployed app.

NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAG_API_SECRET=

# ── Google Calendar connect (existing) ───────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override — defaults to <origin>/api/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# ── WhatsApp connect (Meta Embedded Signup) ──────────────────────────────────
# From developers.facebook.com → your app → App settings → Basic.
# NEXT_PUBLIC_META_APP_ID is not secret (it's sent to the browser to init the
# FB JS SDK); META_APP_SECRET must stay server-only, never NEXT_PUBLIC_.
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=
# The Embedded Signup config_id from developers.facebook.com → your app →
# WhatsApp → Configuration — same value visible in the "Zero integration
# onboarding" / "Customize a new onboarding flow" URL's config_id= param.
NEXT_PUBLIC_META_WA_CONFIG_ID=
